{
  "name": "visual-reader",
  "version": "1.0.0",
  "private": true,
  "description": "Project Visual Reader — AI-generated illustrations for what you read on screen.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:web": "pnpm --filter @visual-reader/web dev",
    "dev:desktop": "cd apps/desktop/src-tauri && cargo tauri dev",
    "build:desktop": "cd apps/desktop/src-tauri && cargo tauri build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0"
}
