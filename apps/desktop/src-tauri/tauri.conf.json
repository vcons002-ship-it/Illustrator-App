{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Visual Reader",
  "version": "1.0.0",
  "identifier": "com.visualreader.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @visual-reader/web dev",
    "beforeBuildCommand": "pnpm --filter @visual-reader/web build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Visual Reader", "width": 1200, "height": 800 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
